// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Prisma Configuration

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // Adjust binary for serverless deployment
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_CONNECTION_STRING")
}

// Entities

model Character {
  id          String @id @default(ulid()) @map("_id")
  name        String @unique
  shortName   String @unique
  description String
  tags        String[]

  // API keys allowed to see this character. Empty (or missing on legacy records) = visible to everyone.
  apiKeys     String[] @default([])

  raceId      String?
  race        Race?   @relation(fields: [raceId], references: [id])

  characteristics Characteristics
  attributes      Attributes
  talents         Talent[]
  health          Health
  defenses        Defense[]
  defaultDefenseId String?
  offenses        Offense[]
  defaultOffenseId String?
  buffProfiles    BuffProfile[]
  activeBuffProfileIds String[]
  stanceModifierProfiles BuffProfile[]
  activeStanceModifierProfileIds String[]
  stateModifierProfiles BuffProfile[]
  activeStateModifierProfileIds String[]
  otherModifierProfiles BuffProfile[]
  activeOtherModifierProfileIds String[]

  stancesIds String[]
  stances    Stance[] @relation(fields: [stancesIds], references: [id])

  statesIds String[]
  states    State[]  @relation(fields: [statesIds], references: [id])

  maneuversIds String[]
  maneuvers    Maneuver[] @relation(fields: [maneuversIds], references: [id])

  powers    Power[]
  powerSpecificationsIds String[]
  powerSpecifications   PowerSpecification[]  @relation(fields: [powerSpecificationsIds], references: [id])
  spellsIds String[]
  spells    Spell[]  @relation(fields: [spellsIds], references: [id])

  perksIds String[]
  perks    Perk[]   @relation(fields: [perksIds], references: [id])

  weaponsIds String[]
  weapons    Weapon[] @relation(fields: [weaponsIds], references: [id])

  armorsIds String[]
  armors    Armor[]  @relation(fields: [armorsIds], references: [id])

  shieldsIds String[]
  shields    Shield[] @relation(fields: [shieldsIds], references: [id])

  inventoryIds String[]
  inventory    InventoryItem[] @relation(fields: [inventoryIds], references: [id])

  mountsIds String[]
  mounts    Mount[]  @relation(fields: [mountsIds], references: [id])

  @@map("characters") // Map to existing collection name in MongoDB
}

model Stance {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  // Structured requirements (Requirement[] — see src/domain/requirements/Requirement.ts).
  // Sole requirements model after the legacy `requirements String[]` cutover.
  structuredRequirements Json?
  // Names of entities this one REPLACES (ROADMAP 8.6). Was authored as a
  // requirement text ("Zastępuje Młyniec"), which it never was — it is a
  // relation between entities, not a condition on the character.
  replaces     String[]
  price        Int
  tags         String[]

  // Combat Lab: structured effects + simulation triage (mirrors Maneuver).
  // Each rank is a separate record; "raising the rank" swaps to the grade+1
  // sibling (see features-to-implement/combat-lab-engine-model-gaps-plan.md §1).
  effects           Json?
  simulatable       Boolean?
  unsupportedReason String?

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("stances")
}

model State {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  // Structured requirements (Requirement[] — see src/domain/requirements/Requirement.ts).
  // Sole requirements model after the legacy `requirements String[]` cutover.
  structuredRequirements Json?
  // Names of entities this one REPLACES (ROADMAP 8.6). Was authored as a
  // requirement text ("Zastępuje Młyniec"), which it never was — it is a
  // relation between entities, not a condition on the character.
  replaces     String[]
  price        Int
  tags         String[]

  // Combat Lab: structured effects + simulation triage (mirrors Maneuver).
  effects           Json?
  simulatable       Boolean?
  unsupportedReason String?

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("states")
}

model Maneuver {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  // Structured requirements (Requirement[] — see src/domain/requirements/Requirement.ts).
  // Sole requirements model after the legacy `requirements String[]` cutover.
  structuredRequirements Json?
  // Names of entities this one REPLACES (ROADMAP 8.6). Was authored as a
  // requirement text ("Zastępuje Młyniec"), which it never was — it is a
  // relation between entities, not a condition on the character.
  replaces     String[]
  price        Int
  castTime     String
  cooldown     Int?
  tags         String[]

  // Combat Lab: structured, engine-readable effects and simulation triage.
  // `effects` is an Effect[] (see src/domain/combat-lab/effects/Effect.ts).
  // `simulatable` = null (unassessed) / true / false; `unsupportedReason`
  // explains a false (out-of-combat subsystem). See
  // features-to-implement/combat-lab-maneuver-analysis-plan.md.
  effects           Json?
  simulatable       Boolean?
  unsupportedReason String?

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("maneuvers")
}

model Perk {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  // Structured requirements (Requirement[] — see src/domain/requirements/Requirement.ts).
  // Sole requirements model after the legacy `requirements String[]` cutover.
  structuredRequirements Json?
  // Names of entities this one REPLACES (ROADMAP 8.6). Was authored as a
  // requirement text ("Zastępuje Młyniec"), which it never was — it is a
  // relation between entities, not a condition on the character.
  replaces     String[]
  price        Int
  tags         String[]

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("perks")
}

model Spell {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  // Structured requirements (Requirement[] — see src/domain/requirements/Requirement.ts).
  // Sole requirements model after the legacy `requirements String[]` cutover.
  structuredRequirements Json?
  // Names of entities this one REPLACES (ROADMAP 8.6). Was authored as a
  // requirement text ("Zastępuje Młyniec"), which it never was — it is a
  // relation between entities, not a condition on the character.
  replaces     String[]
  price        Int
  castTime     String
  cooldown     Int?
  costBase         Int?
  costScalingMode  String?
  costScalingValue Int?
  costRounding     String?
  tags         String[]

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("spells")
}

model Weapon {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]
  style       String
  offense     WeaponOffense
  damageBonus DamageOffense
  range       Int

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("weapons")
}

model Armor {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]

  resistance            Int
  dexterityRestriction  Int
  reflexRestriction     Int
  initiativeRestriction Int
  attributePenalty      Int
  strengthRequirement   Int

  immunity   Int
  protection Int

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("armors")
}

model Shield {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]

  resistance            Int
  dexterityRestriction  Int
  reflexRestriction     Int
  initiativeRestriction Int
  attributePenalty      Int
  strengthRequirement   Int

  block Int

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("shields")
}

model InventoryItem {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("inventory")
}

model Mount {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]

  paceSpeed         Int
  gallopSpeed       Int
  canterSpeed       Int
  horsemanshipBonus Int

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("mounts")
}

model PowerSpecification {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]
  offenses    PowerOffense[]
  
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])
}

model PersonalizationProfileRecord {
  id         String   @id @default(ulid()) @map("_id")
  apiKeyHash String   @unique
  profile    String

  @@map("personalizationProfiles")
}

model BattlePreset {
  id            String   @id @default(ulid()) @map("_id")
  name          String
  apiKeyHash    String

  configuration Json

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([apiKeyHash])
  @@map("battlePresets")
}

// Combat Lab saved simulation run. `configuration` holds the inputs (combatant
// snapshots + seed range + policies), `result` the aggregated SimulationSummary.
// Individual fights are reproduced deterministically from the config, so no
// per-fight logs are stored. See src/domain/combat-lab/persistence/SavedSimulation.ts.
model Simulation {
  id            String   @id @default(ulid()) @map("_id")
  name          String
  apiKeyHash    String

  configuration Json
  result        Json

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([apiKeyHash])
  @@map("simulations")
}

// A reviewable, user-scoped output of the character generator. A draft is
// deliberately independent from Character: generating can never create or
// mutate a playable character before the user explicitly accepts it.
model AiCharacterDraft {
  id                    String                 @id @default(ulid()) @map("_id")
  apiKeyHash            String
  status                AiCharacterDraftStatus @default(pending)
  request               Json
  proposal              Json?
  validationIssues      Json?
  referenceCharacterIds String[]
  provider              String
  model                 String
  promptVersion         String
  generationUsage       Json?
  costMicroUsd          Int                    @default(0)
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedCharacterId   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([apiKeyHash, createdAt])
  @@index([expiresAt])
  @@map("aiCharacterDrafts")
}

// A cost reservation is created before any paid provider request. This makes
// an application-level hard limit possible even when provider budget alerts
// are delayed or only advisory.
model AiGenerationLedger {
  id               String                  @id @default(ulid()) @map("_id")
  apiKeyHash       String
  draftId          String?
  provider         String
  model            String
  state            AiGenerationLedgerState @default(reserved)
  dayBucketUtc     String
  monthBucketUtc   String
  reservedMicroUsd Int
  actualMicroUsd   Int?
  inputTokens      Int?
  outputTokens     Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([apiKeyHash, dayBucketUtc])
  @@index([apiKeyHash, monthBucketUtc])
  @@index([draftId])
  @@map("aiGenerationLedger")
}
// Materialized counters are mutated in the same transaction as a ledger
// reservation. They avoid a read-sum-write race between concurrent requests.
model AiGenerationBudgetCounter {
  id               String                   @id @default(ulid()) @map("_id")
  apiKeyHash       String
  period           AiGenerationBudgetPeriod
  bucket           String
  reservedMicroUsd Int                      @default(0)
  spentMicroUsd    Int                      @default(0)
  generationCount  Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([apiKeyHash, period, bucket])
  @@map("aiGenerationBudgetCounters")
}

model Race {
  id          String @id @default(ulid()) @map("_id")
  name        String @unique
  description String
  tags        String[]

  strengthModifier     Int
  dexterityModifier    Int
  constitutionModifier Int
  mindModifier         Int
  charismaModifier     Int
  spellbornModifier    Int

  characters Character[]

  @@map("races")
}

