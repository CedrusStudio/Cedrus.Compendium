// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Prisma Configuration

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // Adjust binary for serverless deployment
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_CONNECTION_STRING")
}

// Entities

model Character {
  id          String @id @default(ulid()) @map("_id")
  name        String @unique
  shortName   String @unique
  description String
  tags        String[]

  raceId      String?
  race        Race?   @relation(fields: [raceId], references: [id])

  characteristics Characteristics
  attributes      Attributes
  talents         Talent[]
  health          Health
  defenses        Defense[]
  offenses        Offense[]
  buffProfiles    BuffProfile[]
  activeBuffProfileIds String[]
  stanceModifierProfiles BuffProfile[]
  activeStanceModifierProfileIds String[]
  stateModifierProfiles BuffProfile[]
  activeStateModifierProfileIds String[]
  otherModifierProfiles BuffProfile[]
  activeOtherModifierProfileIds String[]

  stancesIds String[]
  stances    Stance[] @relation(fields: [stancesIds], references: [id])

  statesIds String[]
  states    State[]  @relation(fields: [statesIds], references: [id])

  maneuversIds String[]
  maneuvers    Maneuver[] @relation(fields: [maneuversIds], references: [id])

  powers    Power[]
  powerSpecificationsIds String[]
  powerSpecifications   PowerSpecification[]  @relation(fields: [powerSpecificationsIds], references: [id])
  spellsIds String[]
  spells    Spell[]  @relation(fields: [spellsIds], references: [id])

  perksIds String[]
  perks    Perk[]   @relation(fields: [perksIds], references: [id])

  weaponsIds String[]
  weapons    Weapon[] @relation(fields: [weaponsIds], references: [id])

  armorsIds String[]
  armors    Armor[]  @relation(fields: [armorsIds], references: [id])

  shieldsIds String[]
  shields    Shield[] @relation(fields: [shieldsIds], references: [id])

  inventoryIds String[]
  inventory    InventoryItem[] @relation(fields: [inventoryIds], references: [id])

  mountsIds String[]
  mounts    Mount[]  @relation(fields: [mountsIds], references: [id])

  @@map("characters") // Map to existing collection name in MongoDB
}

model Stance {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  requirements String[]
  price        Int
  tags         String[]

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("stances")
}

model State {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  requirements String[]
  price        Int
  tags         String[]

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("states")
}

model Maneuver {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  requirements String[]
  price        Int
  castTime     String
  cooldown     Int?
  tags         String[]

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("maneuvers")
}

model Perk {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  requirements String[]
  price        Int
  tags         String[]

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("perks")
}

model Spell {
  id           String  @id @default(ulid()) @map("_id")
  name         String
  grade        Int
  description  String
  requirements String[]
  price        Int
  castTime     String
  cooldown     Int?
  cost         Int
  costBase         Int?
  costScalingMode  String?
  costScalingValue Int?
  costRounding     String?
  tags         String[]

  // Required by prisma, can be null
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@unique([name, grade(sort: Asc)])
  @@map("spells")
}

model Weapon {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]
  style       String
  offense     WeaponOffense
  damageBonus DamageOffense
  range       Int

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("weapons")
}

model Armor {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]

  resistance            Int
  dexterityRestriction  Int
  reflexRestriction     Int
  initiativeRestriction Int
  attributePenalty      Int
  strengthRequirement   Int

  immunity   Int
  protection Int

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("armors")
}

model Shield {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]

  resistance            Int
  dexterityRestriction  Int
  reflexRestriction     Int
  initiativeRestriction Int
  attributePenalty      Int
  strengthRequirement   Int

  block Int

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("shields")
}

model InventoryItem {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("inventory")
}

model Mount {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]

  paceSpeed         Int
  gallopSpeed       Int
  canterSpeed       Int
  horsemanshipBonus Int

  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])

  @@map("mounts")
}

model PowerSpecification {
  id          String @id @default(ulid()) @map("_id")
  name        String
  description String
  tags        String[]
  offenses    PowerOffense[]
  
  characterIds String[]
  characters   Character[] @relation(fields: [characterIds], references: [id])
}

model PersonalizationProfileRecord {
  id         String   @id @default(ulid()) @map("_id")
  apiKeyHash String   @unique
  profile    String

  @@map("personalizationProfiles")
}

model Race {
  id          String @id @default(ulid()) @map("_id")
  name        String @unique
  description String
  tags        String[]

  strengthModifier     Int
  dexterityModifier    Int
  constitutionModifier Int
  mindModifier         Int
  charismaModifier     Int
  spellbornModifier    Int

  characters Character[]

  @@map("races")
}

// Value Objects

type Characteristics {
  strength     Statistic
  dexterity    Statistic
  constitution Statistic
  mind         Statistic
  charisma     Statistic
  spellborn    Statistic
}

type Attributes {
  fencing      Statistic
  artifice     Statistic
  precision    Statistic
  initiative   Statistic
  martialArt   Statistic
  horsemanship Statistic

  fortitude Statistic
  reflex    Statistic
  willpower Statistic
}

type Statistic {
  grade     Int
  value     Int
  bonus     Int
  testBonus Int
}

type Talent {
  id              String         @default(ulid())
  name            String
  grade           Int
  category        String
  characteristics String
  bonus           Int
  penalty         String?
}

enum TalentCategory {
  zmysł
  język
  fach
  wiedza
  sprawność
  talent
}

type Health {
  barrier       Int
  vitality      Int
  toughness     Int
  recoveryLevel Int
  lethalHealth  Int
  lethalRounds  Int
  bonus         Int
}

type Defense {
  id          String
  name        String
  description String?
  immunity    Int
  resistance  Int
  protection  Int
  block       Int
  parry       Int
  dodge       Int
  bonus       Int
}

type Offense {
  id              String
  name            String
  description     String?
  leadingWeapon   WeaponOffense
  secondaryWeapon WeaponOffense?
  damageBonus     DamageOffense
  additionalDamageBonus DamageOffense?
}

type BuffProfile {
  id              String
  name            String
  description     String?
  linkedEntityId  String?
  characteristics CharacteristicsBuff
  attributes      AttributesBuff
  health          HealthBuff
  defense         DefenseBuff
  offense         OffenseBuff
}

type CharacteristicsBuff {
  strength     StatisticBuff
  dexterity    StatisticBuff
  constitution StatisticBuff
  mind         StatisticBuff
  charisma     StatisticBuff
  spellborn    StatisticBuff
}

type AttributesBuff {
  fencing      StatisticBuff
  artifice     StatisticBuff
  precision    StatisticBuff
  initiative   StatisticBuff
  martialArt   StatisticBuff
  horsemanship StatisticBuff
  fortitude    StatisticBuff
  reflex       StatisticBuff
  willpower    StatisticBuff
}

type StatisticBuff {
  grade     Int
  value     Int
  bonus     Int
  testBonus Int
}

type HealthBuff {
  barrier       Int
  vitality      Int
  toughness     Int
  recoveryLevel Int
  lethalHealth  Int
  lethalRounds  Int
  bonus         Int
}

type DefenseBuff {
  immunity    Int
  resistance  Int
  protection  Int
  block       Int
  parry       Int
  dodge       Int
  bonus       Int
}

type OffenseBuff {
  leadingWeapon         WeaponOffenseBuff
  secondaryWeapon       WeaponOffenseBuff
  damageBonus           DamageOffenseBuff
  additionalDamageBonus DamageOffenseBuff
}

type DamageOffenseBuff {
  amount Int
  grade  Int
  bonus  Int
}

type WeaponOffenseBuff {
  amount        Int
  grade         Int
  bonus         Int
  criticalPower Int
  criticalRange Int
}

type WeaponOffense {
  amount   Int
  grade    Int
  bonus    Int
  isPhantom Boolean
  critical Critical
}

type PowerOffense {
  spellOffense   SpellOffense
  spellDamage   SpellDamage
  description    String
  cost           Int
}

type SpellOffense {
  amount   Int
  grade    Int
  bonus    Int
  isPhantom Boolean
  critical Critical
}

type SpellDamage {
  amount   Int
  grade    Int
  bonus    Int
  isPhantom Boolean
}

type DamageOffense {
  amount Int
  grade  Int
  bonus  Int
  isPhantom Boolean
}

type Critical {
  power Int
  range Int
}

type Power {
  id      String
  name    String
  type    String
  level   Int
  bonus   Int
  essence Int
  description String?

  powerSpecificationId String
  spellsIds String[]
}

enum PowerType {
  moc
  wiez
}
