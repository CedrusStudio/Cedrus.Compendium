### Get Characters

GET http://localhost:3000/api/characters
Content-Type: application/json

### Get Characters

GET http://localhost:3000/api/characters
Content-Type: application/json

### Search Without Select

POST http://localhost:3000/api/characters/search
Content-Type: application/json

{
    "search": {
        "name": "igar"
    },
    "sort": [
        {
            "name": "asc"
        }
    ],
    "pagination": {
        "pageNumber": 1,
        "pageSize": 10
    }
}

### Search Characters with Select

POST http://localhost:3000/api/characters/search
Content-Type: application/json

{
    "search": {
        "name": ""
    },
    "sort": [
        {
            "name": "asc"
        }
    ],
    "select": {
        "id": true,
        "name": true,
        "perks": {
            "select": {
                "id": true,
                "name": true
            }
        }
    }
}

### Search Characters with Offset Pagination

POST http://localhost:3000/api/characters/search
Content-Type: application/json

{
    "search": {
        "name": ""
    },
    "sort": [
        {
            "name": "asc"
        }
    ],
    "pagination": {
        "pageNumber": 1,
        "pageSize": 2
    },
    "select": {
        "id": true,
        "name": true
    }
}

### Search Characters with Keyset Pagination

POST http://localhost:3000/api/characters/search
Content-Type: application/json

{
    "search": {
        "name": ""
    },
    "sort": [
        {
            "name": "asc"
        }
    ],
    "select": {
        "id": true,
        "name": true
    },
    "pagination": {
        "cursor": "01K79QFH0ZD99MSBV4ACKFBZYN",
        "pageSize": 2
    }
}
