          ]
        },
        {
          "id": "subsection-og-uszenie",
          "title": "Ogłuszenie",
          "anchor": "og-uszenie",
          "content": [
            {
              "type": "paragraph",
              "id": "paragraph-4",
              "content": "Postać jest nieprzytomna."
            }
          ]
        }
      ],
      "lastModified": "2025-11-11T09:57:04.631Z"
    },
