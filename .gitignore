# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

#rulebook data
/rulebook-data/
/raw-data/
#/formatted-data/

# mongodb backups (may contain data, don't commit)
/backup/

# testing
/coverage
/test-results/
/playwright-report/
/.mobile-*.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/.vs

# build/test logs and one-off run dumps (never belong in the repo)
.next-build*.log
.build-check.log
.vitest-*.json

# scratch files from debugging sessions
__repro.ts
tsconfig.repro.json
tsconfig.scratch.json

# artefakty montowania dysku (WSL/fuse) — potrafią wpaść do commita
.fuse_hidden*

# warsztat lokalnego generowania postaci przez AI (kontekst, drafty, żądania)
/ai-workspace/*
!/ai-workspace/README.md

# podglądy karty postaci z `npm run verify-sheet-model --html`
/karta-*.html

/dist/mcp/
/storybook-static/
